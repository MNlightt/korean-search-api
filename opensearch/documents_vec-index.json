{
  "settings": {
    "index": { "knn": true },
    "analysis": {
      "tokenizer": {
        "ko_tok": {
          "type": "nori_tokenizer",
          "decompound_mode": "mixed"
        }
      },
      "analyzer": {
        "ko": {
          "type": "custom",
          "tokenizer": "ko_tok",
          "filter": [ "nori_part_of_speech", "nori_readingform", "lowercase" ]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "title":      { "type": "text", "analyzer": "ko" },
      "body":       { "type": "text", "analyzer": "ko" },
      "created_at": { "type": "date" },
      "embedding":  {
        "type": "knn_vector",
        "dimension": 1024,
        "space_type": "innerproduct",
        "method": { "name": "hnsw", "engine": "faiss" }
      }
    }
  }
}